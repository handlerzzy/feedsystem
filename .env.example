# FeedFlow 环境变量模板
# 复制此文件为 .env 后修改实际值
# .env 已被 .gitignore 忽略，不会提交到仓库

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=feedflow

# Redis
REDIS_PASSWORD=123456

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=password123

# JWT（API 必填：未设置时后端启动即失败；生产环境务必改为随机强密钥）
#
# 注意：**worker 不需要这个变量**。worker 只消费 MQ、写 MySQL、更新 Redis 热度，
# 完全不使用 JWT，因此配置校验按角色跳过 jwt.*（见 config.RoleWorker）——
# 早期版本曾因共用校验把 worker 一起卡住，这是修好之后的行为，别再改回去。
JWT_SECRET=feedflow-dev-secret-key

# ---- AI 能力（全部可选）----
#
# AI_ENABLED 是统一总开关，默认 false：关掉后没有任何模型调用、embedding 调用、
# 向量读写，系统行为与引入 AI 之前一致。它覆盖 config.yaml 里的 ai.enabled。
AI_ENABLED=false

# sidecar（Node/TS 的 ModelGateway 服务）调模型用的 provider key。
# 这些只被 sidecar 读取，**绝不**写入日志、错误信息或响应体。
# 父进程（API / Worker）不需要它们——它们只连 sidecar 的 gRPC 端口。
# 一个 key 都不配时，sidecar 仍能正常启动，只是不提供模型服务。
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# 模型名（可选）：覆盖配置文件里的 ai.model。换模型属于运维动作，
# 不该要求改配置文件并重启所有进程；联调/演示环境也常用它切到别的模型。
# AI_DEFAULT_MODEL=gpt-4o-mini

# sidecar 自己的监听地址（只有 sidecar 读它；地址必须是 host:port 的完整形式，
# 写成 ":50051" 会让 grpc-js 在 Node 24 上因空主机名而启动失败）
# AI_GATEWAY_LISTEN_ADDR=0.0.0.0:50051

# 离线演示模式（P1 起）：用进程内的 faux provider 代替真实模型，
# 输出由 AI_FAUX_RESPONSE 指定。**仅用于本地演示与链路验证**，
# 它不访问任何 provider，也不会读取真实凭据。默认关闭。
#
# 它同时覆盖 chat 与 embedding 两条通道（AI_PROVIDER=faux 时两者都走
# 进程内实现）。只让一条通道离线会制造"chat 是假的、向量是真的"这种
# 半真半假的状态，那种演示证明不了任何事。
# AI_PROVIDER=faux
# AI_FAUX_RESPONSE={"summary":"摘要","tags":[{"name":"标签","confidence":0.9}]}
#
# 多条脚本化应答（JSON 字符串数组，按序循环使用）。
# **单条模式在一次进程生命周期内只能成功应答一次**，之后所有请求都会返回
# `No more faux responses queued`；连续发布两条视频就会踩到。需要连续演示或
# 批量评测时用它。它优先于 AI_FAUX_RESPONSE。
# AI_FAUX_RESPONSES=["{\"summary\":\"第一条\"}","{\"summary\":\"第二条\"}"]

# ---- embedding 通道（P2 用；全部可选）----
#
# 它**不经过 pi-ai**（pi-ai 只收录支持 function calling 的模型，不含 embedding），
# sidecar 单独走一条 OpenAI 兼容的 /v1/embeddings 路径。
#
# 这三项必须与 sidecar 的取值一致，compose 已经用同一个变量喂三个服务。
# 发帖不会因为向量生成慢而变慢：向量失败时整条语义路静默关闭。
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIM=1536
# AI_EMBEDDING_NORMALIZE=true
#
# 自建/代理的兼容端点。两个都留空时不做任何向量调用（等价于"向量通道关闭"）。
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_TIMEOUT_MS=10000
